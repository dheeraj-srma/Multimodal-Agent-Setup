{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist-electron",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "electron/**/*",
    "src/types/**/*",
    "src/events/**/*",
    "src/storage/**/*",
    "src/git/**/*",
    "src/workspace/**/*",
    "src/agents/**/*",
    "src/orchestration/**/*",
    "src/ai/**/*"
  ]
}
